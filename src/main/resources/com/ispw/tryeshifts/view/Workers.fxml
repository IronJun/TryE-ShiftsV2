<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<BorderPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.tryeshifts.graphController.WorkersGC">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #4B4488;">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <Label text="E-Shifts" textFill="WHITE" style="-fx-font-size: 24; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
                <Button fx:id="btnHome" text="Home" onAction="#goToHome" style="-fx-background-color: transparent; -fx-text-fill: white;" />
                <Button fx:id="btnShifts" text="Shifts" style="-fx-background-color: transparent; -fx-text-fill: white;" onAction="#goToShifts"/>
                <Button fx:id="btnSettings" text="Settings" style="-fx-background-color: transparent; -fx-text-fill: white;" onAction="#onSettingclicked" />
                <Button fx:id="btnWorkers" text="Workers" style="-fx-background-color: #6A62B3; -fx-text-fill: white; -fx-background-radius: 10;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
                <Circle fill="DODGERBLUE" radius="15.0" stroke="BLACK" strokeType="INSIDE" />
                <Button text="Logout" onAction="#onLogoutClicked" style="-fx-background-color: transparent; -fx-text-fill: white;" />
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;" >
            <children>
                <Label fx:id="titleLabel" style="-fx-font-size: 24; -fx-font-weight: bold;" text="Gestione Lavoratori" />

                <HBox spacing="30" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Team Attivo" />
                            <ListView fx:id="activeWorkersList" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #e67e22;" text="Richieste Pendenti" />
                            <ListView fx:id="pendingWorkersList" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>