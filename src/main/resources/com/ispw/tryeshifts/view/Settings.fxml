<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.ispw.tryeshifts.graphcontroller.gui.SettingsGC" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <fx:include fx:id="navbar" source = "Navbar.fxml"></fx:include>
    </top>

    <center>
        <GridPane fx:id="mainGrid" hgap="30" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
            </columnConstraints>
            <StackPane fx:id = "workplaceStackPane" GridPane.columnIndex="0">
                <VBox fx:id = "leftPane" spacing="15" maxWidth="Infinity" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #dcdde1; -fx-border-radius: 15;">
                    <Label text="Workplace Settings" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4B4488;" />

                    <Label text="Workplace name" />
                    <TextField fx:id="nameField" />

                    <Label text="Address" />
                    <TextField fx:id="addressField" />

                    <Label text="Working days" />
                    <FlowPane fx:id="daysContainer" hgap="10" vgap="10" />

                    <Label text="Active Shifts" />
                    <ListView fx:id="shiftsListView" prefHeight="150" />

                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <ComboBox fx:id="startHourCombo" prefWidth="65" />
                        <ComboBox fx:id="startMinuteCombo" prefWidth="65" />
                        <Label text="-" />
                        <ComboBox fx:id="endHourCombo" prefWidth="65" />
                        <ComboBox fx:id="endMinuteCombo" prefWidth="65" />
                        <Button text="+" onAction="#addShift" style="-fx-background-color: #4B4488; -fx-text-fill: white;" />
                    </HBox>
                    <Label fx:id="errorlabel" textFill="red" visible="false" managed="false" text="Invalid Shifts, the end must be after the start"/>

                    <Region VBox.vgrow="ALWAYS" />
                    <Button text="Save Changes" onAction="#saveWorkplaceChanges" maxWidth="Infinity"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                </VBox>

                <VBox fx:id="overlayPane" alignment="CENTER" spacing="20" visible="false" managed="false"
                      style="-fx-background-color: rgba(255, 255, 255, 0.7); -fx-background-radius: 15;">
                    <padding>
                        <Insets left="40" right="40" />
                    </padding>
                    <effect>
                        <javafx.scene.effect.BoxBlur width="10" height="10" iterations="3" />
                    </effect>
                </VBox>
                <Label fx:id="overlayMessage" text="You are not the owner of this workplace, you can't edit it"
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #4B4488;"
                       visible="false"
                       managed="false"
                />
            </StackPane>

            <VBox fx:id="rightPane" spacing="15" maxWidth="Infinity" GridPane.columnIndex="1"
                  style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #dcdde1; -fx-border-radius: 15;">

                <Label text="User Settings" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4B4488;" />

                <Label text="Name" />
                <TextField fx:id="firstNameField" />

                <Label text="Surname" />
                <TextField fx:id="lastNameField" />

                <Label text="Email (not editable" />
                <TextField fx:id="emailField" editable="false" style="-fx-background-color: #f4f4f4;" />

                <Separator />

                <Label text="Security" style="-fx-font-weight: bold;" />

                <Label text="New Password" />
                <PasswordField fx:id="newPasswordField" promptText="Leave blank to keep it unchanged" />

                <Label text="Confirm Password" />
                <PasswordField fx:id="confirmPasswordField" promptText="Repeat the new password" />

                <Region VBox.vgrow="ALWAYS" />

                <Button text="Save updated profile" onAction="#saveProfileChanges" maxWidth="Infinity"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
            </VBox>
        </GridPane>
    </center>
</BorderPane>