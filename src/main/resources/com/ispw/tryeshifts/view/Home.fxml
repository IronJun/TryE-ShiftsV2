<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.tryeshifts.graphcontroller.HomeGC">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #4B4488;">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
                <Label text="E-Shifts" textFill="WHITE" style="-fx-font-size: 24; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="btnHome" text="Home" style="-fx-background-color: #6A62B3; -fx-text-fill: white; -fx-background-radius: 10;" />
                    <Button fx:id="btnShifts" text="Shifts" style="-fx-background-color: transparent; -fx-text-fill: white;" onAction="#onShiftsclicked" />
                    <Button fx:id="btnSettings" text="Settings" style="-fx-background-color: transparent; -fx-text-fill: white;" onAction="#onSettingsclicked" />
                    <Button fx:id="btnWorkers" text="Workers" style="-fx-background-color: transparent; -fx-text-fill: white;" onAction="#onWorkersclicked" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="Logout" onAction="#onLogoutClicked"
                            style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@assets/logoutIcon.png" backgroundLoading="true" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
            <HBox alignment="CENTER" style="-fx-background-color: transparent;"> <padding>
                <Insets top="10.0" bottom="10.0" />
            </padding>
                <Label fx:id ="errorlbl" textFill= "red" visible="false" managed="false"/>
            </HBox>
        </VBox>

    </top>


    <center>

        <HBox spacing="40.0" alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <VBox alignment="TOP_CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #8379B5; -fx-background-radius: 20;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <Label text="Find Workplaces" textFill="BLACK" style="-fx-font-size: 24; -fx-font-weight: bold;" maxWidth="Infinity" alignment="CENTER" />
                    <TextField fx:id="searchField" promptText="Search Workplace" style="-fx-background-radius: 15;" maxWidth="Infinity" />

                    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10;" maxWidth="Infinity">
                        <ListView fx:id="workplaceListView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-background-color: transparent;" />
                    </VBox>
                </VBox>
                <Button fx:id="btnNewWorkplace" text="New Workplace" style="-fx-background-color: #6a4c93; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 14;" prefWidth="180.0" onAction="#newWpClicked" />
            </VBox>

            <VBox spacing="20.0" HBox.hgrow="ALWAYS">

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <Label text="Your scheduled shifts" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 20; -fx-font-weight: bold;" />
                    <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10;">
                        <Button fx:id="btnPrevWeek" text="&lt; Settimana Precedente" onAction="#handlePrevWeek"
                                style="-fx-background-color: #4B4488; -fx-text-fill: white; -fx-cursor: hand;" />

                        <Label fx:id="lblWeekDisplay" text=""
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4B4488;" />

                        <Button fx:id="btnNextWeek" text="Settimana Successiva &gt;" onAction="#handleNextWeek"
                                style="-fx-background-color: #4B4488; -fx-text-fill: white; -fx-cursor: hand;" />
                    </HBox>
                    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="true" style="-fx-background-radius: 15; -fx-border-color: gray; -fx-border-radius: 15; -fx-background-color: white;">
                        <GridPane fx:id="shiftsGrid" alignment="CENTER" hgap="10" vgap="10">
                            <padding>
                                <Insets bottom="10" left="10" right="10" top="10" />
                            </padding>
                        </GridPane>
                    </ScrollPane>
                </VBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <Label text="Your Workplaces" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold;" />
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-radius: 15; -fx-border-color: gray; -fx-border-radius: 15; -fx-background-color: white;">
                            <VBox fx:id="vboxWorkplaceLegend" spacing="8.0">
                                <padding>
                                    <Insets bottom="10" left="10" right="10" top="10" />
                                </padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                    <VBox alignment="BOTTOM_RIGHT" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="logoImage" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@assets/logoCompletoE-Shifts.png" />
                            </image>
                        </ImageView>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
